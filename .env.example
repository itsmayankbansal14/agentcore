# ===== AgentCore .env =====
# Providers are configured in config/defaults.yaml or config/local.yaml.
# Secrets stay here (gitignored) or in the OS keyring.

# OpenAI (and OpenAI-compatible vendors via LLM_BASE_URL)
OPENAI_API_KEY=

# Gemini
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Local
OLLAMA_BASE_URL=http://localhost:11434

AGENT_NAME=AgentCore
USER_NAME=Boss
